<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cash Counting App</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #74ebd5, #acb6e5);
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
  }

  .container {
    background: #fff;
    padding: 20px;
    border-radius: 15px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    width: 95%;
    max-width: 750px;
  }

  h1 {
    text-align: center;
    font-size: 1.8em;
    margin-bottom: 20px;
    color: #333;
  }

  .flex-row {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: space-between;
  }

  .item {
    flex: 1 1 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #f5f5f5;
    padding: 10px;
    border-radius: 10px;
    transition: transform 0.2s, background 0.2s;
  }

  .item:hover {
    transform: translateY(-2px);
    background: #e0f7fa;
  }

  label {
    font-size: 0.85em;
    margin-bottom: 5px;
    font-weight: bold;
    color: #555;
    text-align: center;
  }

  input[type="number"] {
    width: 60px;
    padding: 6px;
    border-radius: 8px;
    border: 1px solid #ccc;
    text-align: center;
    font-size: 0.9em;
    outline: none;
    transition: border 0.2s;
  }

  input[type="number"]:focus {
    border-color: #00796b;
    box-shadow: 0 0 5px rgba(0,121,107,0.4);
  }

  .result {
    margin-top: 20px;
    text-align: center;
    font-size: 1.4em;
    font-weight: bold;
    color: #00796b;
  }

  @media (max-width: 500px) {
    .item { flex: 1 1 40px; }
    input[type="number"] { width: 40px; }
  }
</style>
</head>
<body>

<div class="container">
  <h1>Cash Counting</h1>
  <div class="flex-row">
    <div class="item"><label>₹2000</label><input type="number" id="note2000" min="0" placeholder=""></div>
    <div class="item"><label>₹500</label><input type="number" id="note500" min="0" placeholder=""></div>
    <div class="item"><label>₹200</label><input type="number" id="note200" min="0" placeholder=""></div>
    <div class="item"><label>₹100</label><input type="number" id="note100" min="0" placeholder=""></div>
    <div class="item"><label>₹50</label><input type="number" id="note50" min="0" placeholder=""></div>
    <div class="item"><label>₹20</label><input type="number" id="note20" min="0" placeholder=""></div>
    <div class="item"><label>₹10</label><input type="number" id="coin10" min="0" placeholder=""></div>
    <div class="item"><label>₹5</label><input type="number" id="coin5" min="0" placeholder=""></div>
    <div class="item"><label>₹2</label><input type="number" id="coin2" min="0" placeholder=""></div>
    <div class="item"><label>₹1</label><input type="number" id="coin1" min="0" placeholder=""></div>
  </div>

  <div class="result" id="result">Total Cash: ₹0</div>
</div>

<script>
const ids = ["note2000","note500","note200","note100","note50","note20","coin10","coin5","coin2","coin1"];

function calculateTotal() {
  let total = 0;
  ids.forEach(id => {
    const val = Number(document.getElementById(id).value) || 0;
    const multiplier = parseInt(id.replace(/\D/g,'')) || 1;
    total += val * multiplier;
  });
  document.getElementById('result').innerText = "Total Cash: ₹" + total;
}

// Live calculation
ids.forEach(id => {
  document.getElementById(id).addEventListener('input', calculateTotal);
});
</script>

</body>
</html>